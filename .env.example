# Copy this file to .env and fill in your key (never commit .env).
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: override the default Groq model.
GROQ_MODEL=

# Optional: rate limiting for the UI (defaults: 10 runs/session, 30s cooldown).
EXECUTO_MAX_RUNS_PER_SESSION=10
EXECUTO_COOLDOWN_SECONDS=30
