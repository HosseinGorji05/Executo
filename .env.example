# Copy this file to .env and fill in your key (never commit .env).
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: override the default Groq model (see https://console.groq.com/docs/models).
GROQ_MODEL=openai/gpt-oss-20b

# Optional: completion-token budget per LLM call. gpt-oss spends tokens on hidden
# reasoning first; too low and hard tasks come back with no code. Default 8192.
GROQ_MAX_TOKENS=8192
# Optional: gpt-oss reasoning depth — low | medium | high. Lower = faster, less
# reasoning, more room for code. Default medium.
GROQ_REASONING_EFFORT=medium

# Optional: rate limiting for the UI (defaults: 10 runs/session, 30s cooldown).
EXECUTO_MAX_RUNS_PER_SESSION=10
EXECUTO_COOLDOWN_SECONDS=30
